<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>${project.parent.groupId}.${project.parent.artifactId}</package>
	<author>FGH</author>

	<description>
		${project.parent.description}
	</description>

	<updateURL>
		https://modules.openmrs.org/modules/download/${project.parent.artifactId}/update.rdf
	</updateURL>

	<require_version>${openMRSVersion}</require_version>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>
	<!-- / Module Properties -->

	<!-- Module Activator -->
	<activator>
		org.openmrs.module.epts.etl.EptsEtlActivator
	</activator>

	<!-- Global Properties -->

	<globalProperty>
		<property>eptsetl.autoCommit</property>
		<description>Enable automatic database commit.</description>
		<defaultValue>false</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.ccrProgramId</property>
		<description>CCR program ID.</description>
		<defaultValue>6</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.etlConfDir</property>
		<description>Directory containing ETL configuration files.</description>
		<defaultValue>/opt/openmrs/etl/conf</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.connectionIsolationLevel</property>
		<description>Database transaction isolation level.</description>
		<defaultValue>TRANSACTION_REPEATABLE_READ</defaultValue>
		<editPrivilege>Manage Protected Settings</editPrivilege>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.driveClassName</property>
		<description>JDBC driver class.</description>
		<defaultValue>com.mysql.cj.jdbc.Driver</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.dataModelType</property>
		<description>EPTS ETL data model type.</description>
		<defaultValue>static</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.defaultExceptionBehavior</property>
		<description>Default behavior when an exception occurs.</description>
		<defaultValue>ABORT_PROCESS</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.defaultInconsistencyBehavior</property>
		<description>Default behavior when an inconsistency is detected.</description>
		<defaultValue>ABORT_PROCESS</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.disableDemographics</property>
		<description>Disable demographic processing.</description>
		<defaultValue>true</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncDstConnectionURI</property>
		<description>SYNC: Destination database connection URI.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.migrDstConnectionURI</property>
		<description>MIGR: Destination database connection URI.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncDstDb</property>
		<description>SYNC: Destination database name.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.migrDstDb</property>
		<description>MIGR: Destination database name.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncDstUserPassword</property>
		<description>SYNC: Destination database password.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.migrDstUserPassword</property>
		<description>MIGR: Destination database password.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncDstUserName</property>
		<description>SYNC: Destination database username.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.migrDstUserName</property>
		<description>MIGR: Destination database username.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.enabled</property>
		<description>Enables or disables automatic ETL execution.</description>
		<defaultValue>false</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.extraCondition</property>
		<description>Enable additional extraction conditions for synchronization.</description>
		<defaultValue>true</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.hivDestinationLocationId</property>
		<description>Destination location ID for HIV data.</description>
		<defaultValue>DESTINATION_LOCATION_ID</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.ignoreAllStartupScripts</property>
		<description>EPTS ETL ignore startup scripts.</description>
		<defaultValue>false</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.includedPatientExtraCondition</property>
		<description>Enable additional patient extraction conditions.</description>
		<defaultValue>true</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.includedPersonBExtraCondition</property>
		<description>Enable additional person B extraction conditions.</description>
		<defaultValue>true</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.includedPersonExtraCondition</property>
		<description>Enable additional person extraction conditions.</description>
		<defaultValue>true</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.locationName</property>
		<description>Source location name used by the ETL.</description>
		<defaultValue>CS JNUNO_Mabjaia</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.logLevel</property>
		<description>Default ETL log level.</description>
		<defaultValue>WARN</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.logLevelConfiguration</property>
		<description>Log level for ETL configuration.</description>
		<defaultValue>WARN</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.logLevelConnection</property>
		<description>Log level for ETL database connections.</description>
		<defaultValue>WARN</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.logLevelController</property>
		<description>Log level for ETL controllers.</description>
		<defaultValue>WARN</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.logLevelDao</property>
		<description>Log level for ETL DAO operations.</description>
		<defaultValue>WARN</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.logLevelEngine</property>
		<description>Log level for ETL engines.</description>
		<defaultValue>WARN</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.logLevelProcessor</property>
		<description>Log level for ETL processors.</description>
		<defaultValue>WARN</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.maxSupportedProcessors</property>
		<description>Maximum number of processors supported by the ETL.</description>
		<defaultValue>1</defaultValue>
	</globalProperty>


	<globalProperty>
		<property>eptsetl.parallelProcessingStrategy</property>
		<description>Parallel processing strategy used by the ETL.</description>
		<defaultValue>SINGLE_THREAD</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.prepProgramId</property>
		<description>PrEP program ID.</description>
		<defaultValue>25</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.processingBatch</property>
		<description>Number of records processed in each batch.</description>
		<defaultValue>100</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.etlRootDir</property>
		<description>Root directory used by the ETL.</description>
		<defaultValue>/opt/openmrs/etl</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.runInDebugMode</property>
		<description>Enable ETL debug execution mode.</description>
		<defaultValue>false</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.smiDestinationLocationId</property>
		<description>Destination location ID for SMI data.</description>
		<defaultValue>DESTINATION_LOCATION_ID</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncSrcConnectionURI</property>
		<description>SYNC: Source database connection URI.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.migrSrcConnectionURI</property>
		<description>MIGR: Source database connection URI.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncSrcDb</property>
		<description>SYNC: Source database name.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.migrSrcDb</property>
		<description>MIGR: Source database name.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.srcLocationList</property>
		<description>List of source locations.</description>
		<defaultValue>SOURCE_LOCATION_LIST</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncSrcUserPassword</property>
		<description>SYNC: Source database password.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.migrSrcUserPassword</property>
		<description>MIGR: Source database password.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncSrcUserName</property>
		<description>SYNC: Source database username.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.migrSrcUserName</property>
		<description>MIGR: Source database username.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.stageRecordIssueBehavior</property>
		<description>Behavior when an issue is detected in a staging record.</description>
		<defaultValue>ABORT_PROCESS</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.startupFile</property>
		<description>EPTS ETL startup configuration file.</description>
		<defaultValue>/opt/openmrs/etl/conf/sync/sis_rme_sesp_sync.json,/opt/openmrs/etl/conf/migr/sesp_sis_rme_migration.json</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncDestinationLocationId</property>
		<description>Destination location ID for synchronization.</description>
		<defaultValue>212</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.syncFragments</property>
		<description>Path to synchronization fragment configuration files.</description>
		<defaultValue>sync/sesp-sync-fragments/*.json</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.tarvProgramId</property>
		<description>TARV program ID.</description>
		<defaultValue>2</defaultValue>
	</globalProperty>


	<globalProperty>
		<property>eptsetl.binPojoDirectory</property>
		<description>Optional directory where compiled POJO classes are written.</description>
		<defaultValue>database-model/pojo/target/classes</defaultValue>
		<editPrivilege>Manage Protected Settings</editPrivilege>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.srcPojoDirectory</property>
		<description>Optional directory where generated POJO source files are written.</description>
		<defaultValue>database-model/pojo/src/main/java</defaultValue>
		<editPrivilege>Manage Protected Settings</editPrivilege>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.maxActiveConnections</property>
		<description>Maximum number of active database connections.</description>
		<defaultValue>12</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.maxIdleConnections</property>
		<description>Maximum number of idle database connections.</description>
		<defaultValue>12</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.minIdleConnections</property>
		<description>Minimum number of idle database connections.</description>
		<defaultValue>4</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.defaultUserId</property>
		<description>Default OpenMRS user ID used by the ETL.</description>
		<defaultValue>1</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.dstTarvServiceId</property>
		<description>Destination TARV service ID.</description>
		<defaultValue>TARV_SERVICE_ID</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.dstCcrServiceId</property>
		<description>Destination CCR service ID.</description>
		<defaultValue>CCR_SERVICE_ID</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.dstPrepServiceId</property>
		<description>Destination PrEP service ID.</description>
		<defaultValue>PREP_SERVICE_ID</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.overrideExistingDataModelElement</property>
		<description>Whether existing ETL data model elements should be overridden.</description>
		<defaultValue>false</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.autoGenerateDataModelForParents</property>
		<description>Whether data model should be automatically generated for parent elements.</description>
		<defaultValue>false</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.disableDataModelGeneration</property>
		<description>Disable automatic data model generation.</description>
		<defaultValue>true</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.disableMultithreadingSearch</property>
		<description>Disable multithreading during data search.</description>
		<defaultValue>false</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.openmrsBaseUrl</property>
		<description>Base URL of the OpenMRS REST API.</description>
		<defaultValue>http://refapp-tomcat:8080/openmrs</defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.openmrsUsername</property>
		<description>Username used to authenticate with the OpenMRS REST API.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.openmrsPassword</property>
		<description>Password used to authenticate with the OpenMRS REST API.</description>
		<defaultValue></defaultValue>
	</globalProperty>

	<globalProperty>
		<property>eptsetl.runningRemigrate</property>
		<description>Enable remigration rules.</description>
		<defaultValue>false</defaultValue>
	</globalProperty>

	<!-- / Global Properties -->

	<!-- Adds link to admin page -->
	<extension>
		<point>org.openmrs.admin.list</point>
		<class>
			org.openmrs.module.epts.etl.extension.html.AdminList
		</class>
	</extension>


	<!-- Maps hibernate files, if present -->
	<mappingFiles>

	</mappingFiles>


	<!-- Internationalization -->
	<!-- All message codes should start with ${project.parent.artifactId}. -->

	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>

	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>

	<messages>
		<lang>es</lang>
		<file>messages_es.properties</file>
	</messages>

	<!-- /Internationalization -->

</module>