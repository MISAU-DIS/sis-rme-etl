{
	"originAppLocationCode": "${location_name}",
	"etlRootDirectory": "${etl_root_dir}",
	"syncStageSchema": "connectors_test_stage_area",
	"templatesDir": "${etl_root_dir}/../templates/*.json",
	"connectors": [
		{
			"id": "src-connector",
			"type": "JDBC",
			"uri": "${srcConnectionURI}",
			"userName": "${srcUserName}",
			"password": "${srcUserPassword}",
			"properties": {
				"driverClassName": "com.mysql.cj.jdbc.Driver",
				"isolationLevel": "${connectionIsolationLevel}",
				"maxActiveConnections": "${maxActiveConnections}",
				"maxIdleConnections": "${maxIdleConnections}",
				"minIdleConnections": "${minIdleConnections}",
				"defaultAutoCommit": "${autoCommit}"
			}
		},
		{
			"id": "dst-connector",
			"type": "JDBC",
			"uri": "${dstConnectionURI}",
			"userName": "${dstUserName}",
			"password": "${dstUserPassword}",
			"properties": {
				"driverClassName": "com.mysql.cj.jdbc.Driver",
				"isolationLevel": "${connectionIsolationLevel}",
				"maxActiveConnections": "${maxActiveConnections}",
				"maxIdleConnections": "${maxIdleConnections}",
				"minIdleConnections": "${minIdleConnections}",
				"defaultAutoCommit": "${autoCommit}"
			}
		},
		{
			"id": "json-file-connector",
			"type": "FILE",
			"uri": "${etl_root_dir}/data_/json"
		}
	],
	"defaultSourceConnector": "src-connector",
	"defaultDestinationConnector": "dst-connector",
	"ignorableStartupScripts": [
		"prepare_schema.sql"
	],
	"dataModel": {
		"databaseObjectInstantiationMode": "PRECOMPILED_POJO_WITH_FALLBACK",
		"schemaMetadataMode": "PRECOMPILED_WITH_FALLBACK",
		"srcPojoPackageName": "testing.etl_src",
		"dstPojoPackageName": "testing.etl_dst",
		"srcSchema": "${src_db}",
		"dstSchema": "${dst_db}",
		"overrideExistingDataModelElement": "${overrideExistingDataModelElement}",
		"autoGenerateDataModelForParents": "${autoGenerateDataModelForParents}",
		"javaFormatterConfigurationFile": "conf/formatter/eclipse-java-formatter.xml",
		"binPojoDirectory": "${binPojoDirectory}",
		"srcPojoDirectory": "${srcPojoDirectory}",
		"srcDataModelId": "testing_etl_src",
		"dstDataModelId": "testing_etl_dst",
		"classPath": [
			"${etl_root_dir}/app/sisrme-etl-api-1.0.jar",
			"${etl_root_dir}/${binPojoDirectory}"
		]
	},
	"ignoreAllStartupScripts": "${ignoreAllStartupScripts}",
	"operations": [
		{
			"template": {
				"name": "etl_operations_for_${dataModelType}_datamodel"
			}
		}
	],
	"params": {
		"dst_db": "${dst_db}",
		"dst_location_id": "${sync_destination_location_id}",
		"excluded_concept_id": "233866",
		"data_proxima_consulta_concept_id": "1410",
		"prep_data_proxima_consulta_concept_id": "165228",
		"tarv_service_concept_id": "6274",
		"prep_service_concept_id": "23894",
		"ccr_service_concept_id": "1872",
		"defaultUserId": "${defaultUserId}"
	},
	"defaultExceptionBehavior": "${defaultExceptionBehavior}",
	"defaultInconsistencyBehavior": "${defaultInconsistencyBehavior}",
	"doNotWarnOnNoDstObjectFound": true,
	"relationshipResolutionStrategy": "VALIDATE_ONLY",
	"stageRecordIssueBehavior": "IGNORE",
	"comments": {
		"defaultInconsistencyBehavior": "MARK_RECORD_AS_FAILED",
		"defaultInconsistencyBehavior_": "ABORT_PROCESS"
	},
	"defaultFieldValues": {
		"voided": 1,
		"date_voided": "1975-01-01",
		"date_created": "1975-01-01",
		"void_reason": "Default Record",
		"retired": 1,
		"date_retired": "1975-01-01",
		"retire_reason": "Default Record",
		"gender": "M"
	},
	"etlItemConfiguration": [
		{
			"source": {
				"connector": "json-file-connector",
				"resource": {
					"name": "person_data.json",
					"layout": "ARRAY",
					"recordPath": "/person_data"
				},
				"jsonDataSource": {
					"name": "person",
					"fields": [
						{
							"name": "id",
							"dataType": "integer"
						},
						{
							"name": "full_name",
							"dataType": "String"
						},
						{
							"name": "creation_date",
							"dataType": "date"
						},
						{
							"name": "uuid",
							"dataType": "string"
						}
					]
				},
				"extraJsonRecordDataSource": [
					{
						"name": "address",
						"path": "/address",
						"cardinality": "ONE",
						"fields": [
							{
								"name": "id",
								"dataType": "integer"
							},
							{
								"name": "person_id",
								"dataType": "integer"
							},
							{
								"name": "full_address",
								"dataType": "string"
							},
							{
								"name": "creation_date",
								"dataType": "date"
							},
							{
								"name": "uuid",
								"dataType": "string"
							}
						]
					}
				]
			},
			"dstConf": [
				{
					"tableName": "person_data",
					"resource": {
						"connector": "dst-connector",
						"name": "person_data"
					},
					"mapping": [
						{
							"dataSourceName": "person",
							"srcField": "uuid",
							"dstField": "person_uuid"
						},
						{
							"srcField": "person.creation_date",
							"dstField": "person_creation_date"
						},
						{
							"srcField": "address.uuid",
							"dstField": "address_uuid"
						},
						{
							"srcField": "address.creation_date",
							"dstField": "address_creation_date"
						}
					],
					"ignorableFields": [
						"creation_date"
					]
				}
			]
		}
	]
}