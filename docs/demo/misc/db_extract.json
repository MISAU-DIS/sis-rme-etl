{
   "processType":"ETL",
   "originAppLocationCode":"${location_name}",
   "etlRootDirectory":"${etl_root_dir}",
   "syncStageSchema":"${src_db}_stage_area",
   "srcConnInfo":{
      "dataBaseUserName":"${srcUserName}",
      "dataBaseUserPassword":"${srcUserPassword}",
      "connectionURI":"${srcConnectionURI}",
      "driveClassName":"${driveClassName}",
      "isolationLevel":"${connectionIsolationLevel}",
      "defaultAutoCommit":"${autoCommit}",
      "maxActiveConnections":"${maxActiveConnections}",
      "maxIdleConnections":"${maxIdleConnections}",
      "minIdleConnections":"${maxIdleConnections}"
   },
   "dstConnInfo":{
      "dataBaseUserName":"${dstUserName}",
      "dataBaseUserPassword":"${dstUserPassword}",
      "connectionURI":"${dstConnectionURI}",
      "driveClassName":"${driveClassName}",
      "databaseSchemaPath":"art_6mmd_2026_data_model.sql",
      "isolationLevel":"${connectionIsolationLevel}",
      "defaultAutoCommit":"${autoCommit}",
      "maxActiveConnections":"${maxActiveConnections}",
      "maxIdleConnections":"${maxIdleConnections}",
      "minIdleConnections":"${maxIdleConnections}"
   },
   "params":{
      "anexesOffices":"10002,10003"
   },
   "operations":[
      {
         "operationType":"DB_PREPARATION",
         "processingBatch":1,
         "processingMode":"SERIAL",
         "parallelProcessingStrategy":"SINGLE_THREAD",
         "totalCountStrategy":"COUNT_ONCE",
         "skipFinalDataVerification":false,
         "finishOnNoRemainRecordsToProcess":true,
         "child":{
            "operationType":"ETL",
            "processingBatch":"${processingBatch}",
            "processingMode":"SERIAL",
            "parallelProcessingStrategy":"${parallelProcessingStrategy}",
            "disableMultithreadingSearch":false,
            "useMysqlInsertIgnore":false,
            "useSharedConnectionPerThread":false,
            "finishOnNoRemainRecordsToProcess":true,
            "totalCountStrategy":"COUNT_ONCE",
            "skipFinalDataVerification":true,
            "maxSupportedProcessors":"${maxSupportedProcessors}",
            "afterEtlActionType":"UNDEFINED",
            "mustRestartInTheEnd":false
         }
      }
   ],
   "etlItemConfiguration":[
      {
         "srcConf":{
            "tableName":"person",
            "tableAlias":"person_src_ds",
            "extraConditionForExtract":"1=1",
            "extraTableDataSource":[
               {
                  "tableName":"person_name",
                  "tableAlias":"person_name_src_ds"
               },
               {
                  "tableName":"person_address",
                  "tableAlias":"person_address_src_ds",
                  "joinType":"LEFT"
               }
            ],
            "extraObjectDataSource":[
               {
                  "name":"empty_address_src_ds",
                  "objectFields":[
                     {
                        "name":"no_address",
                        "value":"No Address",
                        "dataType":"String"
                     }
                  ]
               }
            ]
         },
         "dstConf":[
            {
               "tableName":"person_data",
               "mapping":[
                  {
                     "dstField":"full_name",
                     "transformer":"STRING_TRANSFORMER((person_name_src_ds.given_name).concat(FUNCTION_TRANSFORMER(type:SPACE)).concat(person_name_src_ds.family_name))"
                  },
                  {
                     "dstField":"full_address",
                     "transformer":"COALESCE_TRANSFORMER(person_address_src_ds.address1, empty_address_src_ds.no_address)"
                  },
                  {
                     "srcField":"person_src_ds.uuid",
                     "dstField":"person_uuid"
                  },
                  {
                     "srcField":"person_src_ds.date_created",
                     "dstField":"person_creation_date"
                  },
                  {
                     "srcField":"person_address_src_ds.uuid",
                     "dstField":"address_uuid"
                  },
                  {
                     "srcField":"person_address_src_ds.date_created",
                     "dstField":"address_creation_date"
                  }
               ],
               "ignorableFields":[
                  "creation_date"
               ]
            }
         ]
      }
   ]
}